# Copy to .codex/config.toml after installing Blender's official Lab MCP server.
# Keep the project-local file uncommitted so local executable/environment changes stay local.

[mcp_servers.blender]
command = "blender-mcp"
startup_timeout_sec = 20
tool_timeout_sec = 180
enabled = true
required = false

